# Donnees lourdes : interdites dans Git (consigne du sujet).
# On ignore les IMAGES, pas les fichiers texte : licenses.csv, selection.txt,
# compositions.csv, preparation.json et metadata.jsonl suffisent a reconstruire
# le jeu de donnees a l'identique, et ils pesent quelques kilo-octets.
data/raw/*
!data/raw/.gitkeep
data/processed/**/*.jpg
data/processed/**/*.jpeg
data/processed/**/*.png
data/processed/**/*.webp

# Poids de modeles : hors de Git (consigne du sujet).
# Les rapports d'entrainement (runs/**/entrainement.json), eux, sont versionnes :
# ils contiennent la courbe de perte, la duree, la VRAM et la taille du fichier.
*.ckpt
*.safetensors
*.bin
*.pth
outputs/
checkpoints/
lora_weights/
runs/**/checkpoint-*/

# Artefacts du test rapide de l'Etape 3 : ils valident la chaine, ils ne
# documentent rien. Les garder hors de Git evite aussi que le depot bouge
# sous les pieds d'une session Colab au moment du rebase.
runs/test/
results/test_rapide/

# Archives de poids preparees pour etre televersees dans Colab
*.zip

# Images generees volumineuses (on ne versionne que les figures finales)
results/**/*.png
results/**/*.jpg
!results/figures/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# Systeme
.DS_Store
